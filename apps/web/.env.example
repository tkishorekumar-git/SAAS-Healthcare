# Kenisha web — copy to apps/web/.env.local for local development.
# Full reference: docs/environment.md.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into browser JavaScript at build time.
# NEVER put secrets, database URLs or API keys in a NEXT_PUBLIC_ variable.

# Server-side only: base URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000

# Public: base URL browsers use to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
