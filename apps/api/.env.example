# Kenisha API — copy to apps/api/.env for local development.
# Full reference: docs/environment.md. Never commit the real .env file.

NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app. Staff invitation links (sent by SMS) point here.
WEB_APP_URL=http://localhost:3000

# Swagger UI at /api/docs. Defaults to on outside production, off in production.
SWAGGER_ENABLED=true

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Required. The API connects as kenisha_app — never a superuser or the schema owner —
# so PostgreSQL Row-Level Security applies. Same value as APP_DATABASE_URL in
# packages/database/.env. /api/v1/health/ready reports "misconfigured" for unsafe roles.
DATABASE_URL=postgresql://kenisha_app:local-app-password@localhost:5432/kenisha_dev?schema=kenisha
DATABASE_POOL_MAX=10

# Required. Super Admin (/platform) endpoints connect as kenisha_platform, which PostgreSQL
# denies all access to hospital data. Same value as PLATFORM_DATABASE_URL in packages/database/.env.
PLATFORM_DATABASE_URL=postgresql://kenisha_platform:local-platform-password@localhost:5432/kenisha_dev?schema=kenisha

# --- Authentication (ADR-0003) -------------------------------------------------
# Generate real values with:  pnpm --filter @kenisha/api auth:secrets
# and paste its four lines here. The API refuses to start with invalid keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
OTP_HMAC_SECRET=
# Encrypts Super Admin authenticator secrets. Change it only through the rotation runbook.
PLATFORM_TOTP_KEY=
# Only during a key rotation (docs/security/runbooks/secret-rotation.md); leave unset otherwise.
# JWT_PREVIOUS_PUBLIC_KEY=
# PLATFORM_TOTP_KEY_PREVIOUS=
JWT_ISSUER=kenisha-api
ACCESS_TOKEN_TTL_SECONDS=900

# "development" writes login codes to the API log instead of sending SMS. It is refused
# unless NODE_ENV is development or test. A real provider is chosen before go-live.
SMS_PROVIDER=development

# Browsers accept Secure cookies on http://localhost, so keep this true.
AUTH_COOKIE_SECURE=true
# Login attempts per minute per IP address.
AUTH_THROTTLE_LIMIT=10

# How often expired codes, sessions, invitations and devices are deleted (0 = never).
AUTH_DATA_PURGE_INTERVAL_MINUTES=60

# Shared rate-limit counters (required in production). Leave unset to count in memory.
# REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# local | staging | production. Servers run NODE_ENV=production with staging or production.
DEPLOYMENT_ENV=local
# Proxies in front of the API (the server stack sets 1 for Caddy). 0 locally.
TRUST_PROXY_HOPS=0
