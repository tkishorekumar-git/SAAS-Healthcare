# @kenisha/database — copy to packages/database/.env for local development.
# Full reference: docs/environment.md. LOCAL values only; never commit the real .env.
#
# Each role's password is set by `db:bootstrap` from the URL below, so it lives in one place.
# The username in each URL must match the role name exactly.

# Superuser/admin connection — only used by db:bootstrap and the integration tests.
# Matches POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in the root .env.
DATABASE_ADMIN_URL=postgresql://kenisha:change-me-local-only@localhost:5432/kenisha_dev

# Schema owner — used by the Prisma CLI (migrate, studio).
MIGRATION_DATABASE_URL=postgresql://kenisha_migrator:local-migrator-password@localhost:5432/kenisha_dev?schema=kenisha

# API role (RLS-restricted) — same value as DATABASE_URL in apps/api/.env.
APP_DATABASE_URL=postgresql://kenisha_app:local-app-password@localhost:5432/kenisha_dev?schema=kenisha

# Super Admin role (platform tables only, no patient data).
PLATFORM_DATABASE_URL=postgresql://kenisha_platform:local-platform-password@localhost:5432/kenisha_dev?schema=kenisha

# Password given to every synthetic demo STAFF account by db:seed (local only, min 12 chars).
SEED_STAFF_PASSWORD=Local-Demo-Staff-Pass-2026
