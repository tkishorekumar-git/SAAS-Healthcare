# /opt/kenisha/release.env - not secret. Hosts are set once; image lines are rewritten by
# deploy.sh on every release.
KENISHA_DOMAIN=example.in
KENISHA_APP_HOST=staging-app.example.in
KENISHA_API_HOST=staging-api.example.in
ACME_EMAIL=ops@example.in
API_IMAGE=ghcr.io/OWNER/kenisha-api@sha256:...
WEB_IMAGE=ghcr.io/OWNER/kenisha-web@sha256:...
MIGRATE_IMAGE=ghcr.io/OWNER/kenisha-migrate@sha256:...
POSTGRES_IMAGE=ghcr.io/OWNER/kenisha-postgres@sha256:...
