# /etc/kenisha/api.env on the server (root:root 0600). Placeholders only - generate real
# values on the server (docs/security/runbooks/server-build.md). Reference: docs/environment.md.
NODE_ENV=production
DEPLOYMENT_ENV=staging
API_PORT=4000
CORS_ORIGINS=https://staging-app.example.in
WEB_APP_URL=https://staging-app.example.in
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://kenisha_app:CHANGE_ME@postgres:5432/kenisha?schema=kenisha
PLATFORM_DATABASE_URL=postgresql://kenisha_platform:CHANGE_ME@postgres:5432/kenisha?schema=kenisha
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# pnpm --filter @kenisha/api auth:secrets (run on the server or a trusted machine)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
OTP_HMAC_SECRET=
PLATFORM_TOTP_KEY=
# Staging only: login codes appear in the API log (synthetic data only). Production needs a
# real provider (ADR-0003 I3); the API refuses "development" when DEPLOYMENT_ENV=production.
SMS_PROVIDER=development
AUTH_COOKIE_SECURE=true
