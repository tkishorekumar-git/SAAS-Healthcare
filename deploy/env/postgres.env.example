# /etc/kenisha/postgres.env (root:root 0600).
POSTGRES_USER=kenisha_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kenisha
# Encrypts every backup before it is written. Keep a copy OFFLINE (password manager / sealed
# envelope): without it no backup can be restored. Also on the backup VPS for restore tests.
PGBACKREST_REPO1_CIPHER_PASS=CHANGE_ME
